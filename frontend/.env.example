# FastAPI Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Supabase Anonymous Public Key Only (Never put service role key here!)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# React Bits Pro Registry License Key (used by shadcn CLI via components.json)
REACTBITS_LICENSE_KEY=your-reactbits-license-key-here
