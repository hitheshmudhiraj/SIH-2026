# RailBlock AI - Supabase Configuration (Optional)
# If left blank, the backend automatically uses the built-in persistent local repository (railblock_local.db)
# with 100% identical relational schema and functionality.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PORT=8000
